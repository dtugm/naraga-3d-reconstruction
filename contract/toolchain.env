# Pinned codegen toolchain. The byte-for-byte drift check in every consumer repo
# depends on these EXACT versions — a floating generator version turns all 7
# consumer CIs red at once when upstream changes its output format.
#
# Single source of truth: sourced by scripts/generate.sh here and by each
# consumer's CI drift job (this file is part of the propagated payload).
# To bump: change it here, run scripts/propagate.sh, and every consumer gets the
# new pin and the regenerated output in the same sync PR.
OPENAPI_TYPESCRIPT_VERSION=7.13.0
DATAMODEL_CODE_GENERATOR_VERSION=0.76.0
TYPESCRIPT_VERSION=5.9.3
